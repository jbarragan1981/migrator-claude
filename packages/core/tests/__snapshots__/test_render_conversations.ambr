  dict({
    'conversations/2026/01/2026-01-15_analisis-nandu-q3_a1a1a1a1/artifacts/01-ventas.py': '''
      """Informe de ventas del trimestre."""
      
      from __future__ import annotations
      
      from dataclasses import dataclass
      from decimal import Decimal
      
      IVA = Decimal('0.21')
      
      
      @dataclass(frozen=True)
      class Venta:
          region: str
          importe: Decimal
      
      
      def total(ventas: list[Venta]) -> Decimal:
          return sum((v.importe for v in ventas), Decimal(0))
      
      
      def total_con_iva(ventas: list[Venta]) -> Decimal:
          return total(ventas) * (1 + IVA)
      
      
      def por_region(ventas: list[Venta]) -> dict[str, Decimal]:
          acumulado: dict[str, Decimal] = {}
          for venta in ventas:
              acumulado[venta.region] = acumulado.get(venta.region, Decimal(0)) + venta.importe
          return acumulado
      
      
      def informe(ventas: list[Venta]) -> str:
          lineas = ['# Ventas del trimestre', '']
          for region, importe in sorted(por_region(ventas).items()):
              lineas.append(f'- {region}: {importe:.2f}')
          lineas.append('')
          lineas.append(f'Total: {total(ventas):.2f}')
          lineas.append(f'Total con IVA: {total_con_iva(ventas):.2f}')
          return '\n'.join(lineas)
      
      
      def main() -> None:
          ventas = [Venta('norte', Decimal('1200')), Venta('sur', Decimal('980'))]
          print(informe(ventas))
      
      
      if __name__ == '__main__':
          main()
  
    ''',
  })
